# Meta Marketing Dashboard Configuration
# Copy this file to .env and fill in your values

# ===========================================
# META API CREDENTIALS
# ===========================================
# Your Meta/Facebook access token
# Get this from: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=your_access_token_here

# App ID and Secret (optional, for long-lived tokens)
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret

# ===========================================
# CLIENT AD ACCOUNT IDS
# Format: act_XXXXXXXXXX (include the 'act_' prefix)
# ===========================================
STORELLI_AD_ACCOUNT=act_XXXXXXXXXX
FEELNUYU_AD_ACCOUNT=act_XXXXXXXXXX
LUNA_DAILY_AD_ACCOUNT=act_XXXXXXXXXX
DESIGNRR_AD_ACCOUNT=act_XXXXXXXXXX
SELFTALK_PLUS_AD_ACCOUNT=act_XXXXXXXXXX
BELONG_AD_ACCOUNT=act_XXXXXXXXXX
CELEBRATE_RECOVERY_AD_ACCOUNT=act_XXXXXXXXXX
AXIUM_WEALTH_AD_ACCOUNT=act_XXXXXXXXXX

# ===========================================
# DATABASE
# ===========================================
DATABASE_PATH=data/dashboard.db

# ===========================================
# DASHBOARD SETTINGS
# ===========================================
# Data retention in days
DATA_RETENTION_DAYS=90

# Default currency
DEFAULT_CURRENCY=EUR

# Refresh interval (hours)
AUTO_REFRESH_HOURS=1

# ===========================================
# ALERT THRESHOLDS
# ===========================================
CREATIVE_FRESHNESS_WARNING_DAYS=7
CREATIVE_FRESHNESS_CRITICAL_DAYS=14
ROAS_DROP_THRESHOLD=0.20
CTR_DECLINE_DAYS=3
FREQUENCY_FATIGUE_THRESHOLD=3.0
SPEND_VARIANCE_THRESHOLD=0.15
MIN_DIVERSITY_SCORE=5
LOW_ROAS_SPEND_THRESHOLD=50

# ===========================================
# NOTIFICATIONS (Optional - configure later)
# ===========================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX
# SENDGRID_API_KEY=your_sendgrid_key
# ALERT_EMAIL=your_email@example.com
